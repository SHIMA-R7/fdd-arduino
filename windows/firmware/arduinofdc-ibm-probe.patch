+// Fixed scratch location: last X68000 cylinder, second side.
+extern "C" byte ibm_xdf_write_mfm(byte *buffer, unsigned int remaining);
+
+static byte write_ibm_probe_data(byte *buffer, unsigned int size)
+{
+  // The verified IBM probe header uses the normal post-ID gap. Match
+  // write_data() over the leading gap, then emit the data field on D9.
+  PORTB |= bit(PB1);
+  OCDDR |= bit(OCBIT);
+  TCCRB |= bit(WGM2);
+  TCNT = 0;
+  OCR = 352 * 16 - 256;
+  TIFR = bit(OCF);
+  while (!(TIFR & bit(OCF))) {}
+  TCCRB = 0;
+  WGPORT |= bit(WGBIT);
+  return ibm_xdf_write_mfm(buffer, size + 3);
+}
+
+byte ArduinoFDCClass::ibmProbe(byte *buffer, byte op, byte sizeCode)
+{
+  int8_t position = -1;
+  const byte result = ibmAccess(buffer, op, 76, 1, 0x80 + sizeCode, position);
+  motorOff();
+  return result;
+}
+
+byte ArduinoFDCClass::ibmAccess(byte *buffer, byte op, byte track, byte side,
+                               byte sector, int8_t &position)
+{
+  const bool format = op == 'B' || op == 'K' || op == 'I';
+  const byte sizeCode = track && !format ? sector & 0x7f : 2;
+  const unsigned int size = 128u << sizeCode;
+  motorOn();
+  driveSelect(LOW);
+  digitalWriteOC(PIN_SIDE, side ? LOW : HIGH);
+  if (position < 0) {
+    if (!step_to_track0()) {
+      driveSelect(HIGH);
+      return S_NOTRACK0;
+    }
+    position = 0;
+  }
+  if (position != track) {
+    step_tracks(DT_3_HD, int(track) - position);
+    position = track;
+  }
+  TCCRA = 0;
+  TCCRB = bit(CS0);
+  TCCRC = 0;
+  byte result;
+  if (format) {
+    const auto type = op == 'B' ? DT_3_IBM_PROBE : track ? DT_3_IBM_MIXED : DT_3_IBM_BOOT;
+    result = S_NOTREADY;
+    if (wait_index_hole()) {
+      const unsigned long start = micros();
+      if (wait_index_hole()) {
+        const unsigned long rotation = micros() - start;
+        if (rotation >= (type == DT_3_IBM_MIXED ? 198000UL : 195000UL) && rotation <= 205000UL) {
+          result = is_write_protected() ? S_READONLY :
+                   format_track(buffer, type, 16, track, side, track ? 1 : 2);
+        }
+      }
+    }
+  } else if ((op == 'V' || op == 'U') && is_write_protected()) {
+    result = S_READONLY;
+  } else {
+    noInterrupts();
+    result = wait_header(16, track, side, sector, sizeCode);
+    if (result == S_OK && (op == 'V' || op == 'U')) {
+      result = write_ibm_probe_data(buffer, size);
+    } else if (result == S_OK) {
+      result = read_ibm_probe_data(16, size + 3);
+      while (!(UCSR0A & bit(UDRE0))) {}
+    }
+    interrupts();
+  }
+  driveSelect(HIGH);
+  TCCRB = 0;
+  if (result != S_OK) position = -1;
+  return result;
+}
